# Connection to the PostgreSQL under test. Defaults match docker/compose.yml.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=perf
PG_DB=perfdb

# pgbench scale factor for the OLTP demos (1 = 100,000 accounts, ~15 MB)
PGBENCH_SCALE=10
# seconds per pgbench run
RUN_SECONDS=15

# vector demo: rows, dimensions, clusters, categories
VEC_ROWS=100000
VEC_DIM=384
VEC_CLUSTERS=200
VEC_CATEGORIES=100

# round-trip demo: extra one-way latency the proxy adds, in milliseconds
PROXY_DELAY_MS=0.5
PROXY_PORT=6543
